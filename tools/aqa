#!/usr/bin/env bash
# ============================================================================
# aqa — Deposit OS installer / package fetcher
# ----------------------------------------------------------------------------
#   aqa install <url>        scan a URL for ALL supported package types and
#                            ask which one(s) to install:
#                              .deb   (apt)      checksum REQUIRED
#                              .mlpds (native)   GPG-verified
#                              .apk   (Android)  via Waydroid/adb
#                              .apk   (Alpine)   apk-tools, signature-checked
#                              .exe/.msi (Wine)  routed through deposit-win
#                              .rpm/.pkg.tar.zst routed through deposit-pkg
#                            e.g.  aqa install http://example.com/builds/
#   aqa install <app|turbo>   install a known app (chrome, stream) or the
#                             optional turbo GUI applet (aqa install turbo)
#   aqa list                  show installable apps
#   aqa help                  this message
#
# "aqa install http://example.com" is meant to be typed in a real terminal on a
# physically-installed Deposit OS. It downloads the page, finds compatible
# packages, shows a numbered menu, and installs only what YOU pick.
#
# Options:
#   --dry-run      show what would happen, download/install nothing
#   --yes          non-interactive: install EVERYTHING found (scripted use;
#                  per-type verification rules below still apply)
#   --no-verify    ONLY for curated apps (chrome/stream/turbo): install without
#                  a registered checksum. It does NOT bypass the mandatory
#                  checksum requirement for arbitrary web .deb files.
#   --type deb|mlpds|apk|exe|msi|rpm   restrict the scan to one file type
#
# Security (per type, arbitrary web sources):
#   * .deb        checksum MANDATORY (#sha256= fragment or 2nd argument);
#                 --no-verify does NOT bypass it.
#   * .mlpds      verified by its embedded GPG signature at install time.
#   * .apk        downloaded, sha256 shown; Alpine ones are signature-verified
#                 by apk-tools, Android ones install into the Waydroid sandbox.
#   * .exe/.msi   downloaded, then executed under deposit-win's own policy —
#                 pass #sha256=<hash> to pre-approve (--expect) or whitelist.
#   * .rpm/.pkg.tar.zst handed to deposit-pkg: HASH_POLICY=block refuses any
#                 hash not whitelisted; pass #sha256=<hash> to pre-approve.
# ============================================================================
set -uo pipefail

VERSION="0.2"
REPO_RAW="https://raw.githubusercontent.com/wippsanrinthailand80-commits/deposit-os/main"
APPS_CONF="/etc/deposit/aqa.apps"

# Default app registry (overridable via $APPS_CONF). Format: name|type|url[|sha256]
# The optional 4th field is the expected sha256 of the downloaded file; when
# present, aqa verifies it and refuses to install on mismatch; when ABSENT, the
# app is refused unless --no-verify is given. "stream" has no
# fixed public URL — set AQA_STREAM_URL (or add a line in $APPS_CONF).
DEFAULT_APPS=$(cat <<'EOF'
chrome|deb|https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb|
stream|deb|__STREAM_URL__|
EOF
)

SUDO=""; [[ "$(id -u)" -eq 0 ]] || SUDO="sudo"
DRYRUN=0
RESTRICT=""
NOVERIFY=0
YESALL=0

log(){ echo "aqa: $*"; }
die(){ echo "aqa: $*" >&2; exit 1; }

# pick a downloader
if command -v curl >/dev/null 2>&1; then DL="curl -fsSL"; elif command -v wget >/dev/null 2>&1; then DL="wget -qO-"; else die "need curl or wget"; fi

fetch(){ # fetch URL -> stdout
  case "$DL" in
    curl*) curl -fsSL "$1" ;;
    wget*) wget -qO- "$1" ;;
  esac
}
download(){ # URL -> file
  local url="$1" out="$2"
  case "$DL" in
    curl*) curl -fsSL "$url" -o "$out" ;;
    wget*) wget -q "$url" -O "$out" ;;
  esac
}

app_list(){
  if [[ -f "$APPS_CONF" ]]; then cat "$APPS_CONF"; else echo "$DEFAULT_APPS"; fi
}
app_url(){
  local name="$1" line url
  line="$(app_list | grep -E "^${name}\|")"
  [[ -z "$line" ]] && return 1
  url="$(echo "$line" | cut -d'|' -f3)"
  # allow env override
  [[ "$name" == "stream" && -n "${AQA_STREAM_URL:-}" ]] && url="$AQA_STREAM_URL"
  echo "$url"
}
app_sum(){ # expected sha256 for a known app (may be empty)
  local name="$1" line
  line="$(app_list | grep -E "^${name}\|")"
  [[ -z "$line" ]] && return 1
  echo "$line" | cut -d'|' -f4
}

install_deb(){
  local f="$1"
  if (( DRYRUN )); then log "[dry-run] would install deb: $f"; return 0; fi
  $SUDO apt-get install -y "$f" 2>/dev/null || $SUDO dpkg -i "$f" && $SUDO apt-get install -f -y
}
install_mlpds(){
  local f="$1"
  if (( DRYRUN )); then log "[dry-run] would install mlpds: $f"; return 0; fi
  command -v mlpds >/dev/null 2>&1 || die "mlpds not found in PATH"
  $SUDO mlpds install "$f" --target /
}

# .apk — Android (Waydroid/adb) or Alpine (apk-tools); deposit-apk sniffs.
install_apk_file(){
  local f="$1"
  if (( DRYRUN )); then log "[dry-run] would install apk via deposit-apk: $f"; return 0; fi
  command -v deposit-apk >/dev/null 2>&1 || die "deposit-apk not found in PATH"
  deposit-apk "$f"
}

# .exe/.msi — Wine via deposit-win (its own whitelist/policy still applies).
install_win_file(){
  local url="$1" f="$2" expect="${3:-}" got frag
  frag="${url##*#}"; [[ "$frag" == "$url" ]] && frag=""
  [[ -z "$expect" && "$frag" == sha256=* ]] && expect="${frag#sha256=}"
  got="$(sha256sum "$f" | cut -d' ' -f1)"
  if (( DRYRUN )); then log "[dry-run] would run deposit-win on: $f (sha256 $got)"; return 0; fi
  command -v deposit-win >/dev/null 2>&1 || die "deposit-win not found in PATH"
  if [[ -n "$expect" ]]; then
    if [[ "${expect,,}" != "$got" ]]; then
      log "refusing $url: checksum mismatch (expected $expect, got $got)"; return 1
    fi
    log "checksum verified for $url"
    deposit-win --quiet "--expect=$got" "$f"
    return $?
  fi
  log "handing to deposit-win (sha256 $got) — its whitelist policy governs execution"
  deposit-win --quiet "$f"
}

# --- verify + install a .deb (shared by curated apps and web sources) --------
# $1=url $2=local file $3=curated(0/1) $4=expected sha256 (optional)
# Curated (known apps / turbo): --no-verify is honoured when no checksum is
# registered. Arbitrary web sources: a checksum is MANDATORY (supply via the
# URL #sha256=<hash> fragment or the 2nd install argument); --no-verify is
# ignored, because installing unverified code as root is the riskiest path.
try_install_deb(){
  local url="$1" f="$2" curated="${3:-0}" expect="${4:-}" got
  # Allow the checksum to ride in the URL fragment:  http://x/app.deb#sha256=H
  local frag="${url##*#}"; [[ "$frag" == "$url" ]] && frag=""
  if [[ -z "$expect" && "$frag" == sha256=* ]]; then expect="${frag#sha256=}"; fi
  if [[ -n "$expect" ]]; then
    got="$(sha256sum "$f" | cut -d' ' -f1)"
    if [[ "$got" == "$expect" ]]; then
      log "checksum verified for $url"; install_deb "$f"; return 0
    fi
    log "refusing $url: checksum mismatch (expected $expect, got $got)"; return 1
  fi
  if (( curated )); then
    if (( NOVERIFY )); then
      log "WARN: installing unverified (curated) .deb from $url (--no-verify)"
      install_deb "$f"; return 0
    fi
    log "refusing $url: no checksum registered — pass --no-verify or supply a sha256"
    return 1
  fi
  log "refusing to install unverified .deb from $url"
  log "  a checksum is REQUIRED for arbitrary web sources:"
  log "  append  #sha256=<hash>  to the URL (or pass it as the 2nd install argument)"
  (( NOVERIFY )) && log "  (--no-verify does NOT bypass this requirement)"
  return 1
}

# .rpm/.pkg.tar.zst — via deposit-pkg (its sha256 allowlist policy governs).
install_pkg_file(){
  local url="$1" f="$2" expect="${3:-}" got frag
  frag="${url##*#}"; [[ "$frag" == "$url" ]] && frag=""
  [[ -z "$expect" && "$frag" == sha256=* ]] && expect="${frag#sha256=}"
  got="$(sha256sum "$f" | cut -d' ' -f1)"
  if (( DRYRUN )); then log "[dry-run] would run deposit-pkg on: $f (sha256 $got)"; return 0; fi
  command -v deposit-pkg >/dev/null 2>&1 || die "deposit-pkg not found in PATH"
  if [[ -n "$expect" ]]; then
    if [[ "${expect,,}" != "$got" ]]; then
      log "refusing $url: checksum mismatch (expected $expect, got $got)"; return 1
    fi
    log "checksum verified for $url"
    deposit-pkg "--expect=$got" "$f"
    return $?
  fi
  log "handing to deposit-pkg (sha256 $got) — its whitelist policy governs install"
  deposit-pkg "$f"
}

# --- dispatch one downloaded file by extension ------------------------------
install_scanned(){
  # NOTE: don't merge these locals — ${f##*.} must run AFTER f is assigned
  # (all words of a single `local` expand before any of them are set).
  local url="$1" f="$2" expect="${3:-}"
  case "${f##*/}" in
    *.pkg.tar.zst) install_pkg_file "$url" "$f" "$expect"; return 0 ;;
  esac
  local ext="${f##*.}"
  case "${ext,,}" in
    deb)   try_install_deb "$url" "$f" 0 "$expect" ;;
    mlpds) install_mlpds "$f" ;;
    apk)   install_apk_file "$f" ;;
    exe|msi) install_win_file "$url" "$f" "$expect" ;;
    rpm)   install_pkg_file "$url" "$f" "$expect" ;;
    *) log "skipping unsupported type: .$ext" ;;
  esac
}

type_of(){
  case "${1##*/}" in *.pkg.tar.zst) echo "pkg"; return 0;; esac
  case "${1##*.}" in deb|mlpds|apk|exe|msi|rpm) echo "${1##*.}";; *) echo "?";; esac
}

# --- scan a URL for ALL supported package types ------------------------------
# If the URL is itself a supported file, download it directly. Otherwise treat
# it as an HTML index, list every .deb/.mlpds/.apk/.exe/.msi link, and ask the
# user which to install (numbered picker; --yes installs everything found).
scan_url(){
  local url="$1" expect="${2:-}" html links tmp f path tail
  path="${url%%[?#]*}"; tail="$(basename "$path")"
  case "${tail,,}" in
    *.deb|*.mlpds|*.apk|*.exe|*.msi|*.rpm|*.pkg.tar.zst)
      log "direct file link detected: $url"
      tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
      f="$tmp/$tail"
      download "$url" "$f" || die "download failed: $url"
      install_scanned "$url" "$f" "$expect"
      return 0
      ;;
  esac
  log "scanning $url for .deb/.mlpds/.apk/.exe/.msi/.rpm/.pkg.tar.zst …"
  html="$(fetch "$url")" || die "could not fetch $url"
  links="$(echo "$html" \
     | grep -oE 'href="[^"]+\.(deb|mlpds|apk|exe|msi|rpm|pkg\.tar\.zst)"|href='"'"'[^'"'"']+\.(deb|mlpds|apk|exe|msi|rpm|pkg\.tar\.zst)'"'"'' \
     | sed -E "s/href=[\"']([^\"']+)[\"']/\1/" | sort -u)"
  [[ -z "$links" ]] && { log "no supported package links found at $url"; return 0; }

  # build the candidate table (honour --type)
  local -a CAND_URL=() CAND_NAME=()
  local rel n=0
  for rel in $links; do
    case "$rel" in http*|/*) f="$rel" ;; *) f="$(dirname "$url")/$rel" ;; esac
    [[ -n "$RESTRICT" && "${f##*.}" != "$RESTRICT" ]] && continue
    n=$((n+1)); CAND_URL+=("$f"); CAND_NAME+=("$(basename "$f")")
  done
  (( n )) || { log "no supported package links found at $url (--type filter?)"; return 0; }

  echo ""
  echo "Found $n supported package(s):"
  local i
  for (( i=0; i<n; i++ )); do
    printf '  %d) %-45s [%s]\n' $((i+1)) "${CAND_NAME[$i]}" "$(type_of "${CAND_NAME[$i]}")"
  done
  echo ""

  if (( DRYRUN )); then log "[dry-run] nothing downloaded or installed."; return 0; fi

  # pick
  local ans sel picks=""
  if (( YESALL )); then
    picks="all"
  elif [[ -t 0 ]]; then
    read -r -p "Install which? [1-$n, a=all, q=quit] " ans
    case "${ans,,}" in
      ""|q|quit) log "cancelled."; return 0 ;;
      a|all) picks="all" ;;
      *) picks="$ans" ;;
    esac
  else
    die "non-interactive shell — re-run with --yes to install everything found,"
        "or run from a terminal to choose."
  fi

  tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
  local choice
  if [[ "$picks" == "all" ]]; then
    for (( i=0; i<n; i++ )); do
      log "installing ${CAND_NAME[$i]} …"
      out="$tmp/${CAND_NAME[$i]}"
      download "${CAND_URL[$i]}" "$out" || { log "download failed: ${CAND_URL[$i]}"; continue; }
      install_scanned "${CAND_URL[$i]}" "$out" "$expect" || log "could not install ${CAND_NAME[$i]}"
    done
    return 0
  fi
  for choice in $picks; do
    [[ "$choice" =~ ^[0-9]+$ ]] || { log "ignoring bad selection: $choice"; continue; }
    (( choice >= 1 && choice <= n )) || { log "selection out of range: $choice"; continue; }
    i=$((choice-1))
    log "installing ${CAND_NAME[$i]} …"
    out="$tmp/${CAND_NAME[$i]}"
    download "${CAND_URL[$i]}" "$out" || { log "download failed: ${CAND_URL[$i]}"; continue; }
    install_scanned "${CAND_URL[$i]}" "$out" "$expect" || log "could not install ${CAND_NAME[$i]}"
  done
}

# --- install a known app / the turbo component -----------------------------
install_app(){
  local name="$1"
  case "$name" in
    turbo)
      install_turbo ;;
    chrome|stream)
      local url; url="$(app_url "$name")" || die "unknown app: $name"
      [[ "$url" == "__STREAM_URL__" || -z "$url" ]] && \
        die "no URL configured for '$name' (set AQA_STREAM_URL or add a line to $APPS_CONF)"
      if (( DRYRUN )); then log "[dry-run] would install $name from $url"; return 0; fi
      local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
      local out="$tmp/$(basename "$url")"
      log "downloading $name ..."
      download "$url" "$out" || die "download failed: $url"
      # Curated: honour a registered checksum, or --no-verify when none exists.
      local sum; sum="$(app_sum "$name" 2>/dev/null || true)"
      try_install_deb "$url" "$out" 1 "$sum" || die "aqa: $name was not installed (see above)"
      ;;
    *) die "unknown app: $name (try: $(app_list | cut -d'|' -f1 | paste -sd' '))" ;;
  esac
}

# Embedded integrity baseline for the turbo applet components. These are the
# sha256 of the files in this same repo at this commit, so `aqa install turbo`
# verifies the downloaded bytes actually match what we ship (prevents a MITM /
# tampered download from executing `bash install.sh` unverified).
declare -A TURBO_SUMS=(
  [deposit-tray.py]=7a8f047344431e8015465d544ee666844e885eb14a7dd0627d9b21acd661d5fb
  [install.sh]=3daefbeef4d5dd3e91709d436404354b7f777a33e6b38010c0170c34139118c7
  [deposit-turbo.desktop]=c27ce99f8ec7c2e0c823317162e66c76ba89b641f9dbc894fff1835353d40bf8
)

# The turbo GUI applet is an optional component (keeps the base image light).
install_turbo(){
  if (( DRYRUN )); then
    log "[dry-run] would install turbo applet from $REPO_RAW/components/turbo"
    return 0
  fi
  local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
  cd "$tmp"
  for f in deposit-tray.py install.sh deposit-turbo.desktop; do
    download "$REPO_RAW/components/turbo/$f" "$f" || die "could not fetch turbo component: $f"
    local got; got="$(sha256sum "$f" | cut -d' ' -f1)"
    local exp="${TURBO_SUMS[$f]:-}"
    if [[ -n "$exp" ]]; then
      [[ "$got" == "$exp" ]] || die "aqa: turbo component $f checksum mismatch (expected $exp, got $got) — refusing"
      log "checksum verified for turbo/$f"
    elif (( NOVERIFY )); then
      log "WARN: installing unverified turbo component $f (--no-verify)"
    else
      die "aqa: no checksum registered for turbo/$f — refusing to install unverified. Use --no-verify (not recommended)"
    fi
  done
  $SUDO bash install.sh
}

usage(){
  sed -n '3,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# --- arg parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRYRUN=1; shift ;;
    --yes|-y) YESALL=1; shift ;;
    --no-verify) NOVERIFY=1; shift ;;
    --type)    RESTRICT="${2#.}"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]:-}"

[[ $# -eq 0 ]] && { usage; exit 1; }
case "$1" in
  install)
    shift
    [[ $# -eq 0 ]] && die "install needs an app name (chrome|stream|turbo) or a URL"
    if [[ "$1" == *://* || "$1" == http* || "$1" == ftp* ]]; then
      scan_url "$1" "${2:-}"
    else
      install_app "$1"
    fi
    ;;
  list)    app_list | sed 's/|/  ->  /g' ;;
  help)    usage ;;
  http*|ftp*|file*|*/|*.html|*.php|*.com|*.net|*.org)
           scan_url "$1" ;;
  *://*)   scan_url "$1" ;;
  *)       die "unknown argument: $1 (try: aqa help)" ;;
esac
