#!/usr/bin/env bash
# ============================================================================
# aqa — Deposit OS installer / package fetcher
# ----------------------------------------------------------------------------
#   aqa install <url>        scan a URL for .deb / .mlpds files and install them
#                              e.g.  aqa install http://example.com/builds/
#   aqa install <app|turbo>   install a known app (chrome, stream) or the
#                             optional turbo GUI applet (aqa install turbo)
#   aqa list                  show installable apps
#   aqa help                  this message
#
# "aqa install http://example.com" is meant to be typed in a real terminal on a
# physically-installed Deposit OS. It downloads, finds compatible .deb/.mlpds
# files, and installs them immediately.
#
# Options:
#   --dry-run      show what would happen, download/install nothing
#   --no-verify    install code from the internet WITHOUT a checksum/signature
#                  (dangerous; only for trusted local sources)
#   --type deb|mlpds   restrict the scan to one file type
#
# Security: a known app is only installed if its registered sha256 matches (or
# you pass --no-verify). A .deb found by scanning an arbitrary URL is REFUSED
# unless you supply its expected sha256 or pass --no-verify. .mlpds files are
# verified through the GPG signature on the package.
# ============================================================================
set -uo pipefail

VERSION="0.1"
REPO_RAW="https://raw.githubusercontent.com/wippsanrinthailand80-commits/deposit-os/main"
APPS_CONF="/etc/deposit/aqa.apps"

# Default app registry (overridable via $APPS_CONF). Format: name|type|url[|sha256]
# The optional 4th field is the expected sha256 of the downloaded file; when
# present, aqa verifies it and refuses to install on mismatch; when ABSENT, the
# app is refused unless --no-verify is given. "stream" has no
# fixed public URL — set AQA_STREAM_URL (or add a line in $APPS_CONF).
DEFAULT_APPS=$(cat <<'EOF'
chrome|deb|https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb|
stream|deb|__STREAM_URL__|
EOF
)

SUDO=""; [[ "$(id -u)" -eq 0 ]] || SUDO="sudo"
DRYRUN=0
RESTRICT=""
NOVERIFY=0

log(){ echo "aqa: $*"; }
die(){ echo "aqa: $*" >&2; exit 1; }

# pick a downloader
if command -v curl >/dev/null 2>&1; then DL="curl -fsSL"; elif command -v wget >/dev/null 2>&1; then DL="wget -qO-"; else die "need curl or wget"; fi

fetch(){ # fetch URL -> stdout
  case "$DL" in
    curl*) curl -fsSL "$1" ;;
    wget*) wget -qO- "$1" ;;
  esac
}
download(){ # URL -> file
  local url="$1" out="$2"
  case "$DL" in
    curl*) curl -fsSL "$url" -o "$out" ;;
    wget*) wget -q "$url" -O "$out" ;;
  esac
}

app_list(){
  if [[ -f "$APPS_CONF" ]]; then cat "$APPS_CONF"; else echo "$DEFAULT_APPS"; fi
}
app_url(){
  local name="$1" line url
  line="$(app_list | grep -E "^${name}\|")"
  [[ -z "$line" ]] && return 1
  url="$(echo "$line" | cut -d'|' -f3)"
  # allow env override
  [[ "$name" == "stream" && -n "${AQA_STREAM_URL:-}" ]] && url="$AQA_STREAM_URL"
  echo "$url"
}
app_sum(){ # expected sha256 for a known app (may be empty)
  local name="$1" line
  line="$(app_list | grep -E "^${name}\|")"
  [[ -z "$line" ]] && return 1
  echo "$line" | cut -d'|' -f4
}

install_deb(){
  local f="$1"
  if (( DRYRUN )); then log "[dry-run] would install deb: $f"; return 0; fi
  $SUDO apt-get install -y "$f" 2>/dev/null || $SUDO dpkg -i "$f" && $SUDO apt-get install -f -y
}
install_mlpds(){
  local f="$1"
  if (( DRYRUN )); then log "[dry-run] would install mlpds: $f"; return 0; fi
  command -v mlpds >/dev/null 2>&1 || die "mlpds not found in PATH"
  $SUDO mlpds install "$f" --target /
}

# --- scan a URL for .deb/.mlpds and install --------------------------------
# $2 (optional) is the expected sha256 of the file(s) found. A .deb from an
# arbitrary URL is only installed if it matches that checksum OR --no-verify is
# given; otherwise it is refused (installing code from the internet with no
# integrity/authenticity check is the most dangerous path in aqa).
scan_url(){
  local url="$1" expect="${2:-}" html links tmp f
  log "scanning $url"
  html="$(fetch "$url")" || die "could not fetch $url"
  links="$(echo "$html" | grep -oE 'href="[^"]+\.(deb|mlpds)"' | sed -E 's/href="([^"]+)"/\1/' | sort -u)"
  [[ -z "$links" ]] && { log "no .deb/.mlpds links found at $url"; return 0; }
  tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
  for rel in $links; do
    case "$rel" in
      http*|/*) f="$rel" ;;
      *) f="$(dirname "$url")/$rel" ;;
    esac
    [[ -n "$RESTRICT" && "$f" != *.$RESTRICT ]] && continue
    log "found: $f"
    if (( DRYRUN )); then log "[dry-run] would fetch+install $f"; continue; fi
    out="$tmp/$(basename "$f")"
    download "$f" "$out" || { log "download failed: $f"; continue; }
     case "$out" in
      *.deb)
        if [[ -n "$expect" ]]; then
          local got; got="$(sha256sum "$out" | cut -d' ' -f1)"
          if [[ "$got" == "$expect" ]]; then
            log "checksum verified for $f"; install_deb "$out"
          else
            log "refusing $f: checksum mismatch (expected $expect, got $got)"
          fi
        elif (( NOVERIFY )); then
          log "WARN: installing unverified .deb from $f (--no-verify)"
          install_deb "$out"
        else
          log "refusing to install unverified .deb from $f"
          log "  supply the expected sha256, or re-run with --no-verify (not recommended)"
        fi
        ;;
      *.mlpds) install_mlpds "$out" ;;
    esac
  done
}

# --- install a known app / the turbo component -----------------------------
install_app(){
  local name="$1"
  case "$name" in
    turbo)
      install_turbo ;;
    chrome|stream)
      local url; url="$(app_url "$name")" || die "unknown app: $name"
      [[ "$url" == "__STREAM_URL__" || -z "$url" ]] && \
        die "no URL configured for '$name' (set AQA_STREAM_URL or add a line to $APPS_CONF)"
      if (( DRYRUN )); then log "[dry-run] would install $name from $url"; return 0; fi
      local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
      local out="$tmp/$(basename "$url")"
      log "downloading $name ..."
      download "$url" "$out" || die "download failed: $url"
      # Verify against a registered checksum when one exists.
      local sum; sum="$(app_sum "$name" 2>/dev/null || true)"
      if [[ -n "$sum" ]]; then
        local got; got="$(sha256sum "$out" | cut -d' ' -f1)"
        [[ "$got" == "$sum" ]] || die "aqa: checksum mismatch for $name (expected $sum, got $got) — refusing"
        log "checksum verified for $name"
      elif (( NOVERIFY )); then
        log "WARN: no checksum registered for $name; installing unverified (--no-verify)"
      else
        die "aqa: no checksum registered for '$name' — refusing to install unverified. Add the sha256 to $APPS_CONF or pass --no-verify (not recommended)"
      fi
      install_deb "$out"
      ;;
    *) die "unknown app: $name (try: $(app_list | cut -d'|' -f1 | paste -sd' '))" ;;
  esac
}

# Embedded integrity baseline for the turbo applet components. These are the
# sha256 of the files in this same repo at this commit, so `aqa install turbo`
# verifies the downloaded bytes actually match what we ship (prevents a MITM /
# tampered download from executing `bash install.sh` unverified).
declare -A TURBO_SUMS=(
  [deposit-tray.py]=7a8f047344431e8015465d544ee666844e885eb14a7dd0627d9b21acd661d5fb
  [install.sh]=3daefbeef4d5dd3e91709d436404354b7f777a33e6b38010c0170c34139118c7
  [deposit-turbo.desktop]=c27ce99f8ec7c2e0c823317162e66c76ba89b641f9dbc894fff1835353d40bf8
)

# The turbo GUI applet is an optional component (keeps the base image light).
install_turbo(){
  if (( DRYRUN )); then
    log "[dry-run] would install turbo applet from $REPO_RAW/components/turbo"
    return 0
  fi
  local tmp; tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
  cd "$tmp"
  for f in deposit-tray.py install.sh deposit-turbo.desktop; do
    download "$REPO_RAW/components/turbo/$f" "$f" || die "could not fetch turbo component: $f"
    local got; got="$(sha256sum "$f" | cut -d' ' -f1)"
    local exp="${TURBO_SUMS[$f]:-}"
    if [[ -n "$exp" ]]; then
      [[ "$got" == "$exp" ]] || die "aqa: turbo component $f checksum mismatch (expected $exp, got $got) — refusing"
      log "checksum verified for turbo/$f"
    elif (( NOVERIFY )); then
      log "WARN: installing unverified turbo component $f (--no-verify)"
    else
      die "aqa: no checksum registered for turbo/$f — refusing to install unverified. Use --no-verify (not recommended)"
    fi
  done
  $SUDO bash install.sh
}

usage(){
  sed -n '3,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# --- arg parsing -----------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRYRUN=1; shift ;;
    --no-verify) NOVERIFY=1; shift ;;
    --type)    RESTRICT="${2#.}"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]:-}"

[[ $# -eq 0 ]] && { usage; exit 1; }
case "$1" in
  install)
    shift
    [[ $# -eq 0 ]] && die "install needs an app name (chrome|stream|turbo) or a URL"
    if [[ "$1" == *://* || "$1" == http* || "$1" == ftp* ]]; then
      scan_url "$1" "${2:-}"
    else
      install_app "$1"
    fi
    ;;
  list)    app_list | sed 's/|/  ->  /g' ;;
  help)    usage ;;
  http*|ftp*|file*|*/|*.html|*.php|*.com|*.net|*.org)
           scan_url "$1" ;;
  *://*)   scan_url "$1" ;;
  *)       die "unknown argument: $1 (try: aqa help)" ;;
esac
