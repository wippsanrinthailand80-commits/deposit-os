#!/usr/bin/env python3
"""Deposit OS Security Center — firewall + AppArmor + AV scan in one panel.

Launched from the quick menu's Security tile. Firewall toggles run through
pkexec; the AV scan runs deposit-av against the user's home.
"""
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

CSS = """
window { background-color: rgba(244,244,247,0.98); border-radius: 18px; }
.header { font-size: 16px; font-weight: 700; color: #1c1c28; }
.row { padding: 6px 2px; }
.label { font-weight: 600; color: #1c1c28; }
.status { color: #555; }
.value-on { color: #1f9d55; font-weight: 700; }
.value-off { color: #c0392b; font-weight: 700; }
button { border-radius: 10px; }
"""


def run(cmd, timeout=30):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=timeout)
    except Exception:
        return None


def ufw_active():
    r = run("ufw status 2>/dev/null | head -1")
    return bool(r and "active" in r.stdout.lower())


def aa_enabled():
    r = run("aa-status --enabled >/dev/null 2>&1 && echo on || echo off")
    return (r.stdout.strip() if r else "off") == "on"


def clamav_present():
    return subprocess.run("command -v clamscan >/dev/null 2>&1",
                          shell=True).returncode == 0


class SecurityCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Deposit Security Center")
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_decorated(False)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(16)
        self.add(box)

        hdr = Gtk.Label(label="Deposit Security Center")
        hdr.get_style_context().add_class("header")
        hdr.set_xalign(0)
        box.pack_start(hdr, False, False, 0)

        # Firewall
        fw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        fw.get_style_context().add_class("row")
        l = Gtk.Label(label="Firewall (ufw)")
        l.get_style_context().add_class("label")
        self.fw_val = Gtk.Label()
        self.fw_val.get_style_context().add_class("status")
        self.fw_btn = Gtk.Button()
        self.fw_btn.connect("clicked", self.on_fw)
        fw.pack_start(l, True, True, 0)
        fw.pack_start(self.fw_val, False, False, 0)
        fw.pack_start(self.fw_btn, False, False, 0)
        box.pack_start(fw, False, False, 0)

        # AppArmor
        aa = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        aa.get_style_context().add_class("row")
        l = Gtk.Label(label="AppArmor")
        l.get_style_context().add_class("label")
        self.aa_val = Gtk.Label()
        self.aa_val.get_style_context().add_class("status")
        aa.pack_start(l, True, True, 0)
        aa.pack_start(self.aa_val, False, False, 0)
        box.pack_start(aa, False, False, 0)

        # AV scan
        av = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        av.get_style_context().add_class("row")
        l = Gtk.Label(label="Antivirus (ClamAV)")
        l.get_style_context().add_class("label")
        av.pack_start(l, True, True, 0)
        scan = Gtk.Button(label="Run scan")
        scan.connect("clicked", self.on_scan)
        av.pack_start(scan, False, False, 0)
        box.pack_start(av, False, False, 0)

        self.out = Gtk.Label(label=("(ClamAV " +
                                    ("present" if clamav_present() else "not installed") +
                                    ")"))
        self.out.get_style_context().add_class("status")
        self.out.set_xalign(0)
        box.pack_start(self.out, False, False, 0)

        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda w: self.destroy())
        box.pack_start(close, False, False, 0)

        self.refresh()
        self.show_all()

    def refresh(self):
        on = ufw_active()
        self.fw_val.set_text("ON" if on else "OFF")
        self.fw_val.get_style_context().remove_class("value-on")
        self.fw_val.get_style_context().remove_class("value-off")
        self.fw_val.get_style_context().add_class("value-on" if on else "value-off")
        self.fw_btn.set_label("Disable" if on else "Enable")

        ae = aa_enabled()
        self.aa_val.set_text("enabled" if ae else "off")
        self.aa_val.get_style_context().remove_class("value-on")
        self.aa_val.get_style_context().remove_class("value-off")
        self.aa_val.get_style_context().add_class("value-on" if ae else "value-off")

    def on_fw(self, btn):
        want = "disable" if ufw_active() else "--force enable"
        run("pkexec ufw %s" % want)
        GLib.timeout_add(800, self._refresh_safe)

    def _refresh_safe(self):
        self.refresh()
        return False

    def on_scan(self, btn):
        btn.set_label("Scanning…")
        self.out.set_text("Scanning home directory…")
        r = run('deposit-av "$HOME" 2>&1 | tail -6', timeout=300)
        txt = (r.stdout.strip() if r and r.stdout else "scan complete")
        self.out.set_text(txt)
        btn.set_label("Run scan")


if __name__ == "__main__":
    SecurityCenter()
    Gtk.main()
