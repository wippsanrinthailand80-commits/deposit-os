#!/usr/bin/env python3
"""Deposit OOBE — first-boot setup wizard (runs once, skipped on live ISO)."""
import os
import re
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

SENTINEL = "/var/lib/deposit/oobe-done"
LIVE = "boot=live" in open("/proc/cmdline").read()

# Allowlist for free-text fields. These are passed as argv/data, never into a
# shell, but we still constrain them to a safe charset as defense in depth.
TZ_RE = re.compile(r"^[A-Za-z0-9_./+:-]{1,40}$")
LOC_RE = re.compile(r"^[A-Za-z0-9_@./-]{1,40}$")
KB_RE = re.compile(r"^[A-Za-z0-9_-]{1,20}$")


def run(cmd, timeout=30):
    """Run a command given as an argv list (NEVER a shell string)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def pkexec_script(script, args, stdin=None, timeout=300):
    """Run a *constant* shell script via pkexec, passing untrusted values as
    positional arguments ($1, $2, ...) so they are never re-parsed by the
    shell. `stdin` (bytes/str) is forwarded to the script (e.g. for chpasswd)."""
    try:
        return subprocess.run(
            ["pkexec", "sh", "-c", script, "_", *args],
            input=stdin, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


class OOBE(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to Deposit OS")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_keep_above(True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(20)
        self.add(box)
        box.pack_start(Gtk.Label(label="Welcome to Deposit OS"), False, False, 0)
        box.pack_start(Gtk.Label(label="Finish setup now — you can change these later."), False, False, 0)
        self.tz = Gtk.Entry(); self.tz.set_text("UTC")
        self._row(box, "Timezone", self.tz)
        self.loc = Gtk.Entry(); self.loc.set_text("en_US.UTF-8")
        self._row(box, "Language (locale)", self.loc)
        self.kb = Gtk.Entry(); self.kb.set_text("us")
        self._row(box, "Keyboard layout", self.kb)
        self.pw = Gtk.Entry(); self.pw.set_visibility(False)
        self._row(box, "New password", self.pw)
        self.pw2 = Gtk.Entry(); self.pw2.set_visibility(False)
        self._row(box, "Confirm password", self.pw2)
        fin = Gtk.Button(label="Finish")
        fin.connect("clicked", self.on_finish)
        box.pack_start(fin, False, False, 0)
        self.status = Gtk.Label(label="")
        box.pack_start(self.status, False, False, 0)
        self.show_all()

    def _row(self, box, label, widget):
        r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        l = Gtk.Label(label=label); l.set_xalign(0)
        r.pack_start(l, False, False, 0)
        r.pack_start(widget, True, True, 0)
        box.pack_start(r, False, False, 0)

    def on_finish(self, btn):
        if self.pw.get_text() != self.pw2.get_text():
            self.status.set_text("Passwords do not match.")
            return
        if not self.pw.get_text():
            self.status.set_text("Password cannot be empty — set a password.")
            return
        btn.set_label("Applying…")
        GLib.idle_add(self._apply)

    def _apply(self):
        tz = self.tz.get_text() or "UTC"
        loc = self.loc.get_text() or "en_US.UTF-8"
        kb = self.kb.get_text() or "us"
        pw = self.pw.get_text()
        # Constrain to safe charsets (values are still passed as argv/data below).
        if not TZ_RE.match(tz):
            tz = "UTC"
        if not LOC_RE.match(loc):
            loc = "en_US.UTF-8"
        if not KB_RE.match(kb):
            kb = "us"
        pw = pw.replace("\n", "").replace("\r", "")

        # Constant script; untrusted values ($1 tz, $2 loc, $3 kb) are argv,
        # and the password is piped via stdin to chpasswd (never parsed by sh).
        script = (
            'timedatectl set-timezone "$1" 2>/dev/null || true; '
            'printf "LANG=%s\\n" "$2" > /etc/default/locale; '
            'locale-gen "$2" 2>/dev/null || true; '
            'if grep -q "^XKBLAYOUT=" /etc/default/keyboard; then '
            '  sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\\"$3\\"/" /etc/default/keyboard; '
            'else echo "XKBLAYOUT=\\"$3\\"" >> /etc/default/keyboard; fi; '
            # First-boot setup is complete: on an installed machine we no longer
            # want passwordless autologin into a sudo-capable account, so drop the
            # autologin drop-in (the live ISO skips OOBE, so it keeps autologin).
            'rm -f /etc/lightdm/lightdm.conf.d/50-deposit-autologin.conf 2>/dev/null || true; '
            'chpasswd'
        )
        pkexec_script(script, [tz, loc, kb], stdin="deposit:%s\n" % pw)
        run(["setxkbmap", kb])
        os.makedirs("/var/lib/deposit", exist_ok=True)
        open(SENTINEL, "w").close()
        self.status.set_text("Done! You can close this window.")
        return False


if __name__ == "__main__":
    if LIVE or os.path.exists(SENTINEL):
        import sys
        sys.exit(0)
    OOBE()
    Gtk.main()
