#!/usr/bin/env bash
# deposit-quickmenu-toggle — show/hide the Deposit quick menu.
# Sends SIGUSR1 to the running instance (which toggles visibility); if it is
# not running, launches it. Bound to Super+Q in the XFCE session.
#
# PID trust: before signalling we confirm the process at that PID really is the
# quick menu (via /proc/<pid>/cmdline). A stale pidfile could otherwise point at
# an unrelated process that reused the PID — we must not signal strangers.
set -uo pipefail
for P in /run/deposit-quickmenu.pid /tmp/deposit-quickmenu.pid; do
  [[ -f "$P" ]] || continue
  pid="$(cat "$P" 2>/dev/null)"
  [[ "$pid" =~ ^[0-9]+$ ]] || continue
  [[ -f "/proc/$pid/cmdline" ]] || continue
  if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "deposit-quickmenu"; then
    if kill -USR1 "$pid" 2>/dev/null; then
      exit 0
    fi
  fi
done
# not running -> start it
deposit-quickmenu &
