#!/usr/bin/env python3
"""Deposit OS Settings — a simple Samsung One UI / Android-hybrid settings hub.

A light, rounded card window with a gear header and a vertical list of
category rows. Toggles (Wi-Fi, Airplane, Turbo) and sliders (Brightness,
Volume) act inline; Security / Updates / About launch the matching tool or
a small dialog. Launch with `deposit-settings`.
"""
import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

GEAR_SVG = "/usr/share/pixmaps/deposit-gear.svg"
ICONS = {
    "wifi": "network-wireless",
    "airplane": "airplane-mode",
    "display": "video-display",
    "sound": "audio-volume-high",
    "turbo": "drive-harddisk",
    "security": "security-high",
    "updates": "system-software-update",
    "about": "dialog-information",
}


def run(cmd, timeout=15):
    """Run an argv list (no shell)."""
    try:
        if isinstance(cmd, str):
            import shlex
            cmd = shlex.split(cmd)
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def launch(args):
    try:
        subprocess.Popen(args, start_new_session=True)
    except Exception:
        pass


# --------------------------------------------------------------------------
# backends (kept small + self-contained)
# --------------------------------------------------------------------------
def wifi_on():
    r = run(["nmcli", "radio", "wifi"])
    return bool(r and r.stdout.strip().lower() == "enabled")


def set_wifi(on):
    run(["nmcli", "radio", "wifi", "on" if on else "off"])


def airplane_on():
    r = run(["rfkill", "list", "all"])
    return bool(r and "Soft blocked: yes" in r.stdout)


def set_airplane(on):
    run(["rfkill", "block" if on else "unblock", "all"])


def turbo_state():
    r = run(["cat", "/var/lib/deposit-turbo/state"])
    return (r.stdout.strip() if r and r.stdout.strip() else "off")


def set_turbo(on):
    run(["deposit-turbo", "on" if on else "off"])


def brightness_pct():
    r = run(["brightnessctl", "g"])
    if r and r.stdout.strip().isdigit():
        m = run(["brightnessctl", "m"])
        if m and m.stdout.strip().isdigit() and int(m.stdout.strip()):
            return int(r.stdout.strip()) * 100 // int(m.stdout.strip())
    return 50


def set_brightness(pct):
    pct = max(0, min(100, pct))
    run(["brightnessctl", "s", "%d%%" % pct])


def volume_pct():
    r = run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
    if r and r.stdout:
        import re
        m = re.search(r"(\d+)%", r.stdout)
        if m:
            return int(m.group(1))
    return 50


def set_volume(pct):
    pct = max(0, min(100, pct))
    run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", "%d%%" % pct])


def about_text():
    info = {}
    try:
        for line in open("/etc/os-release"):
            if "=" in line:
                k, v = line.strip().split("=", 1)
                info[k] = v.strip('"')
    except Exception:
        pass
    name = info.get("NAME", "Deposit OS")
    ver = info.get("VERSION_ID", "rolling")
    return "%s %s\nGNU/Linux (from-the-kernel build)\nOwn .mlpds / AQA packages + apt/deb" % (name, ver)


CSS = """
window { background-color: #eef0f5; }
.card { background-color: #ffffff; border-radius: 18px; }
.header { font-size: 17px; font-weight: 700; color: #1c1c28; }
.row { padding: 12px 14px; border-bottom: 1px solid #eef0f5; }
.row:last-child { border-bottom: none; }
.title { font-weight: 600; color: #1c1c28; font-size: 14px; }
.sub { color: #8a8f9c; font-size: 11px; }
.gear { color: #3b6dff; }
scale { min-height: 20px; }
scale trough { background: #dfe2ea; border-radius: 6px; }
scale highlight { background: #3b6dff; border-radius: 6px; }
"""


def icon(name, size=22):
    img = Gtk.Image()
    fn = ICONS.get(name)
    if fn:
        img.set_from_icon_name(fn, Gtk.IconSize.MENU)
        img.set_pixel_size(size)
    img.set_opacity(0.85)
    return img


def gear_header():
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    box.set_border_width(16)
    g = Gtk.Image()
    if os.path.exists(GEAR_SVG):
        g.set_from_file(GEAR_SVG)
        g.set_pixel_size(28)
    else:
        g.set_from_icon_name("preferences-system", Gtk.IconSize.DND)
    g.get_style_context().add_class("gear")
    title = Gtk.Label(label="Settings")
    title.get_style_context().add_class("header")
    box.pack_start(g, False, False, 0)
    box.pack_start(title, True, True, 0)
    close = Gtk.Button(label="×")
    close.set_relief(Gtk.ReliefStyle.NONE)
    close.connect("clicked", lambda w: Gtk.main_quit())
    box.pack_end(close, False, False, 0)
    return box


class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Deposit Settings")
        self.set_default_size(360, 560)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.connect("destroy", Gtk.main_quit)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_border_width(10)
        self.add(outer)
        outer.pack_start(gear_header(), False, False, 0)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.get_style_context().add_class("card")

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(card)
        outer.pack_start(scroll, True, True, 0)

        self._build_rows(card)
        self.show_all()

    # -- row construction ---------------------------------------------------
    def _row(self, card, icon_name, title, sub, control=None, on_click=None):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.get_style_context().add_class("row")
        ic = icon(icon_name)
        ic.set_margin_top(2)
        row.pack_start(ic, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label(label=title)
        t.get_style_context().add_class("title")
        t.set_xalign(0)
        text.pack_start(t, False, False, 0)
        if sub:
            s = Gtk.Label(label=sub)
            s.get_style_context().add_class("sub")
            s.set_xalign(0)
            text.pack_start(s, False, False, 0)
        row.pack_start(text, True, True, 0)
        if control:
            row.pack_end(control, False, False, 0)
        elif on_click:
            row.set_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            row.connect("button-press-event", lambda w, e: on_click())
        card.pack_start(row, False, False, 0)
        return row

    def _switch(self, initial, cb):
        sw = Gtk.Switch()
        sw.set_active(initial)
        sw.connect("notify::active", lambda s, p: cb(s.get_active()))
        return sw

    def _build_rows(self, card):
        # Network group
        self._row(card, "wifi", "Wi-Fi",
                  "Wireless networking" if wifi_on() else "Off",
                  control=self._switch(wifi_on(), self._on_wifi))
        self._row(card, "airplane", "Airplane mode",
                  "Blocks all radios" if airplane_on() else "Off",
                  control=self._switch(airplane_on(), self._on_airplane))
        # Display + Sound
        br = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        br.set_value(brightness_pct())
        br.set_size_request(150, -1)
        br.set_draw_value(False)
        br.connect("value-changed", lambda s: set_brightness(int(s.get_value())))
        self._row(card, "display", "Display", "Brightness", control=br)

        vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        vol.set_value(volume_pct())
        vol.set_size_request(150, -1)
        vol.set_draw_value(False)
        vol.connect("value-changed", lambda s: set_volume(int(s.get_value())))
        self._row(card, "sound", "Sound", "Volume", control=vol)
        # Turbo
        self._row(card, "turbo", "Turbo",
                  "Performance mode on" if turbo_state() == "on" else "Off",
                  control=self._switch(turbo_state() == "on", self._on_turbo))
        # Tools
        self._row(card, "security", "Security", "Firewall, AV, AppArmor",
                  on_click=lambda: launch(["deposit-security"]))
        self._row(card, "updates", "Updates", "Check for OS updates",
                  on_click=lambda: launch(["deposit-updater"]))
        self._row(card, "about", "About", "Version and system info",
                  on_click=self._on_about)

    # -- handlers ------------------------------------------------------------
    def _on_wifi(self, on):
        set_wifi(on)

    def _on_airplane(self, on):
        set_airplane(on)

    def _on_turbo(self, on):
        set_turbo(on)

    def _on_about(self):
        d = Gtk.MessageDialog(parent=self, flags=0,
                               message_type=Gtk.MessageType.INFO,
                               buttons=Gtk.ButtonsType.OK,
                               text="About Deposit OS")
        d.format_secondary_text(about_text())
        d.run()
        d.destroy()


if __name__ == "__main__":
    try:
        Settings()
        Gtk.main()
    except Exception as e:
        print("deposit-settings:", e)
