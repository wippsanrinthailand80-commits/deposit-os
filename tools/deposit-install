#!/usr/bin/env bash
# ============================================================================
# deposit-install — install the running Deposit OS to a target disk.
# Designed to run from the live ISO (boot=live). Copies the current system,
# builds an initramfs, writes fstab and installs GRUB (BIOS + UEFI).
#
# Usage:  deposit-install [DEVICE]
#   If DEVICE is omitted, available disks are listed and you are prompted.
# ============================================================================
set -uo pipefail

usage(){ echo "Usage: deposit-install [DEVICE]   (e.g. deposit-install /dev/sda)"; }

# --- choose a target ---------------------------------------------------------
TARGET="${1:-}"
if [[ -z "$TARGET" ]]; then
  echo "deposit-install: available disks:"
  lsblk -d -p -n -o NAME,SIZE,MODEL 2>/dev/null | sed 's/^/  /'
  read -r -p "Enter the device to INSTALL to (or Ctrl-C to cancel): " TARGET
fi
[[ -b "$TARGET" ]] || { echo "deposit-install: '$TARGET' is not a block device"; exit 2; }

VER="$(ls /lib/modules 2>/dev/null | head -1)"
[ -n "$VER" ] || { echo "deposit-install: no kernel modules found"; exit 1; }

echo
echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
echo "  WARNING: this will ERASE ALL DATA on $TARGET and install Deposit OS."
echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
read -r -p "Type 'yes' to continue: " CONFIRM
[[ "$CONFIRM" == "yes" ]] || { echo "deposit-install: aborted."; exit 3; }

echo "deposit-install: target=$TARGET  kernel=$VER"

# --- partition (GPT: ESP + root) ----------------------------------------------
echo "deposit-install: partitioning $TARGET…"
parted -s "$TARGET" mklabel gpt
parted -s "$TARGET" mkpart ESP fat32 1MiB 513MiB
parted -s "$TARGET" set 1 esp on
parted -s "$TARGET" mkpart root ext4 513MiB 100%
partprobe "$TARGET" || true
sleep 2

RP="${TARGET}2"
EP="${TARGET}1"
mkfs.fat -F32 "$EP"
mkfs.ext4 -F "$RP"

mkdir -p /mnt/droot
mount "$RP" /mnt/droot
mkdir -p /mnt/droot/boot/efi
mount "$EP" /mnt/droot/boot/efi

# --- copy the running system (exclude virtual filesystems) -------------------
echo "deposit-install: copying files…"
rsync -aAX --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
  --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/live \
  --exclude=/lost+found / /mnt/droot/

# --- initramfs for the installed kernel --------------------------------------
echo "deposit-install: building initramfs…"
if ! chroot /mnt/droot update-initramfs -k "$VER" -c; then
  chroot /mnt/droot mkinitramfs -o "/boot/initrd.img-$VER" "$VER"
fi

# --- fstab -------------------------------------------------------------------
ROOT_UUID="$(blkid -s UUID -o value "$RP")"
EFI_UUID="$(blkid -s UUID -o value "$EP")"
cat > /mnt/droot/etc/fstab <<EOF
UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 2
EOF

# --- bootloader --------------------------------------------------------------
echo "deposit-install: installing GRUB…"
chroot /mnt/droot grub-install --target=x86_64-efi --efi-directory=/boot/efi \
  --bootloader-id=deposit --removable || echo "deposit-install: note: UEFI grub-install failed (continuing)"
chroot /mnt/droot grub-install --target=i386-pc "$TARGET" || echo "deposit-install: note: BIOS grub-install failed (continuing)"
chroot /mnt/droot update-grub || echo "deposit-install: note: update-grub failed"

echo "deposit" > /mnt/droot/etc/hostname

sync
umount /mnt/droot/boot/efi || true
umount /mnt/droot || true
echo "deposit-install: done. Remove the USB stick and reboot into $TARGET."
